       IDENTIFICATION DIVISION.
       PROGRAM-ID. BATCH-PROCESSOR.
       AUTHOR. PAYROLL-SYSTEM.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-MAINFRAME.
       OBJECT-COMPUTER. IBM-MAINFRAME.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EMPLOYEE-FILE
               ASSIGN TO 'EMPLOYEE-DATA.dat'
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-INPUT-STATUS.
           SELECT REPORT-FILE
               ASSIGN TO 'SALARY-REPORT.txt'
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-OUTPUT-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  EMPLOYEE-FILE
           RECORDING MODE IS F
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 80 CHARACTERS.
       01  EMPLOYEE-RECORD.
           05  EMP-ID              PIC X(06).
           05  EMP-NAME            PIC X(30).
           05  DEPT-CODE           PIC X(04).
           05  SALARY              PIC 9(07)V99.
           05  HIRE-YEAR           PIC 9(04).
           05  FILLER              PIC X(29).

       FD  REPORT-FILE
           RECORDING MODE IS F
           BLOCK CONTAINS 0 RECORDS
           RECORD CONTAINS 132 CHARACTERS.
       01  REPORT-RECORD           PIC X(132).

       WORKING-STORAGE SECTION.
       01  WS-FILE-STATUS.
           05  WS-INPUT-STATUS     PIC XX VALUE SPACES.
           05  WS-OUTPUT-STATUS    PIC XX VALUE SPACES.

       01  WS-EOF-FLAG             PIC X VALUE 'N'.
           88  WS-EOF              VALUE 'Y'.
           88  WS-NOT-EOF          VALUE 'N'.

       01  WS-COUNTERS.
           05  WS-TOTAL-RECORDS    PIC 9(06) VALUE ZEROS.
           05  WS-VALID-RECORDS    PIC 9(06) VALUE ZEROS.
           05  WS-INVALID-RECORDS  PIC 9(06) VALUE ZEROS.
           05  WS-DEPT-COUNT       PIC 9(04) VALUE ZEROS.

       01  WS-ACCUMULATORS.
           05  WS-TOTAL-SALARY     PIC 9(12)V99 VALUE ZEROS.
           05  WS-AVG-SALARY       PIC 9(10)V99 VALUE ZEROS.
           05  WS-MAX-SALARY       PIC 9(07)V99 VALUE ZEROS.
           05  WS-MIN-SALARY       PIC 9(07)V99 VALUE 9999999.99.

       01  WS-CURRENT-DEPT         PIC X(04) VALUE SPACES.

       01  WS-REPORT-LINES.
           05  WS-HEADER-1.
               10  FILLER          PIC X(40) VALUE
                   '========================================'.
               10  FILLER          PIC X(52) VALUE
                   '============================================'.
           05  WS-HEADER-2.
               10  FILLER          PIC X(20) VALUE SPACES.
               10  FILLER          PIC X(30) VALUE
                   'EMPLOYEE SALARY SUMMARY REPORT'.
               10  FILLER          PIC X(82) VALUE SPACES.
           05  WS-DETAIL-LINE.
               10  WS-DL-LABEL     PIC X(30) VALUE SPACES.
               10  WS-DL-VALUE     PIC X(20) VALUE SPACES.
               10  FILLER          PIC X(82) VALUE SPACES.
           05  WS-SALARY-DETAIL.
               10  WS-SD-LABEL     PIC X(30) VALUE SPACES.
               10  WS-SD-AMOUNT    PIC $$$,$$$,$$9.99.
               10  FILLER          PIC X(89) VALUE SPACES.

       PROCEDURE DIVISION.
       MAIN-LOGIC.
           PERFORM 000-INITIALIZE
           PERFORM 100-PROCESS-RECORDS
               UNTIL WS-EOF
           PERFORM 300-WRITE-SUMMARY
           PERFORM 999-TERMINATE
           STOP RUN.

       000-INITIALIZE.
           OPEN INPUT EMPLOYEE-FILE
           IF WS-INPUT-STATUS NOT EQUAL '00'
               DISPLAY 'ERROR OPENING INPUT FILE: ' WS-INPUT-STATUS
               MOVE 'Y' TO WS-EOF-FLAG
               GO TO 000-INITIALIZE-EXIT
           END-IF
           OPEN OUTPUT REPORT-FILE
           IF WS-OUTPUT-STATUS NOT EQUAL '00'
               DISPLAY 'ERROR OPENING REPORT FILE: ' WS-OUTPUT-STATUS
               CLOSE EMPLOYEE-FILE
               MOVE 'Y' TO WS-EOF-FLAG
               GO TO 000-INITIALIZE-EXIT
           END-IF
           MOVE ZEROS TO WS-TOTAL-RECORDS
           MOVE ZEROS TO WS-VALID-RECORDS
           MOVE ZEROS TO WS-INVALID-RECORDS
           MOVE ZEROS TO WS-TOTAL-SALARY
           MOVE ZEROS TO WS-MAX-SALARY
           MOVE 9999999.99 TO WS-MIN-SALARY
           READ EMPLOYEE-FILE
               AT END MOVE 'Y' TO WS-EOF-FLAG
           END-READ.
       000-INITIALIZE-EXIT.
           EXIT.

       100-PROCESS-RECORDS.
           ADD 1 TO WS-TOTAL-RECORDS
           PERFORM 200-PROCESS-RECORD
           READ EMPLOYEE-FILE
               AT END MOVE 'Y' TO WS-EOF-FLAG
           END-READ.

       200-PROCESS-RECORD.
           IF SALARY NOT GREATER THAN ZEROS
               ADD 1 TO WS-INVALID-RECORDS
               GO TO 200-PROCESS-RECORD-EXIT
           END-IF
           ADD 1 TO WS-VALID-RECORDS
           ADD SALARY TO WS-TOTAL-SALARY
           IF SALARY GREATER THAN WS-MAX-SALARY
               MOVE SALARY TO WS-MAX-SALARY
           END-IF
           IF SALARY LESS THAN WS-MIN-SALARY
               MOVE SALARY TO WS-MIN-SALARY
           END-IF
           IF DEPT-CODE NOT EQUAL WS-CURRENT-DEPT
               ADD 1 TO WS-DEPT-COUNT
               MOVE DEPT-CODE TO WS-CURRENT-DEPT
           END-IF.
       200-PROCESS-RECORD-EXIT.
           EXIT.

       300-WRITE-SUMMARY.
           MOVE WS-HEADER-1 TO REPORT-RECORD
           WRITE REPORT-RECORD
           MOVE WS-HEADER-2 TO REPORT-RECORD
           WRITE REPORT-RECORD
           MOVE WS-HEADER-1 TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE 'TOTAL RECORDS PROCESSED:' TO WS-DL-LABEL
           MOVE WS-TOTAL-RECORDS TO WS-DL-VALUE
           MOVE WS-DETAIL-LINE TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE 'VALID RECORDS:' TO WS-DL-LABEL
           MOVE WS-VALID-RECORDS TO WS-DL-VALUE
           MOVE WS-DETAIL-LINE TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE 'INVALID RECORDS:' TO WS-DL-LABEL
           MOVE WS-INVALID-RECORDS TO WS-DL-VALUE
           MOVE WS-DETAIL-LINE TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE 'DEPARTMENTS ENCOUNTERED:' TO WS-DL-LABEL
           MOVE WS-DEPT-COUNT TO WS-DL-VALUE
           MOVE WS-DETAIL-LINE TO REPORT-RECORD
           WRITE REPORT-RECORD

           IF WS-VALID-RECORDS GREATER THAN ZEROS
               COMPUTE WS-AVG-SALARY =
                   WS-TOTAL-SALARY / WS-VALID-RECORDS
           END-IF

           MOVE 'TOTAL SALARY EXPENSE:' TO WS-SD-LABEL
           MOVE WS-TOTAL-SALARY TO WS-SD-AMOUNT
           MOVE WS-SALARY-DETAIL TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE 'AVERAGE SALARY:' TO WS-SD-LABEL
           MOVE WS-AVG-SALARY TO WS-SD-AMOUNT
           MOVE WS-SALARY-DETAIL TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE 'HIGHEST SALARY:' TO WS-SD-LABEL
           MOVE WS-MAX-SALARY TO WS-SD-AMOUNT
           MOVE WS-SALARY-DETAIL TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE 'LOWEST SALARY:' TO WS-SD-LABEL
           MOVE WS-MIN-SALARY TO WS-SD-AMOUNT
           MOVE WS-SALARY-DETAIL TO REPORT-RECORD
           WRITE REPORT-RECORD

           MOVE WS-HEADER-1 TO REPORT-RECORD
           WRITE REPORT-RECORD.

       999-TERMINATE.
           CLOSE EMPLOYEE-FILE
           CLOSE REPORT-FILE
           DISPLAY 'BATCH PROCESSING COMPLETE.'
           DISPLAY 'TOTAL RECORDS: ' WS-TOTAL-RECORDS
           DISPLAY 'VALID RECORDS: ' WS-VALID-RECORDS
           DISPLAY 'TOTAL SALARY:  ' WS-TOTAL-SALARY.
